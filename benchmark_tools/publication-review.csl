<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US" demote-non-dropping-particle="never">
  <info>
    <title>OrthoHMM bibliography metadata review</title>
    <id>https://github.com/JLSteenwyk/orthohmm/publication-review</id>
    <updated>2026-09-19T00:00:00+00:00</updated>
    <summary>Full bylines and explicit identifiers for review, not a journal submission style.</summary>
  </info>
  <macro name="authors">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " and="text" delimiter="; "/>
    </names>
  </macro>
  <citation><layout><text variable="citation-number"/></layout></citation>
  <bibliography entry-spacing="1">
    <sort><key variable="author"/><key variable="issued"/><key variable="title"/></sort>
    <layout suffix=".">
      <group delimiter=". ">
        <text macro="authors"/>
        <choose>
          <if variable="issued"><date variable="issued"><date-part name="year"/></date></if>
          <else><text term="no date" form="short"/></else>
        </choose>
        <text variable="title"/>
        <text variable="genre"/>
        <text variable="container-title" font-style="italic"/>
        <group delimiter=", ">
          <text variable="volume"/>
          <text variable="issue" prefix="Issue: "/>
          <text variable="page"/>
          <text variable="number" prefix="Identifier: "/>
        </group>
        <text variable="publisher"/>
        <text variable="DOI" prefix="DOI: "/>
        <text variable="URL"/>
        <date variable="accessed" prefix="Accessed: " delimiter="-">
          <date-part name="year"/><date-part name="month" form="numeric-leading-zeros"/>
          <date-part name="day" form="numeric-leading-zeros"/>
        </date>
      </group>
    </layout>
  </bibliography>
</style>
