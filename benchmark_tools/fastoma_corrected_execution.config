// Retain the historical host workflow and its scientific defaults.
includeConfig '/mnt/ca1e2e99-718e-417c-9ba6-62421455971a/SOFTWARE/FastOMA/nextflow.config'
includeConfig 'fastoma_qfo.config'

params.max_cpus = 180
params.max_memory = '700.GB'
params.fasta_header_id_transformer = 'UniProt'
params.force_pairwise_ortholog_generation = true
params.omamer_db = '/mnt/ca1e2e99-718e-417c-9ba6-62421455971a/ORTHOHMM/orthohmm/qfo_benchmark/data/LUCA.h5'

executor {
    name = 'local'
    cpus = 180
    memory = 700.GB
}

docker {
    enabled = true
    runOptions = '--network none'
}

process {
    executor = 'local'
    container = 'dessimozlab/fastoma@sha256:67c802a71c2d150ba8825a8c5dbc5a8a68e1dd42554e6695038043d666ac358b'
    // Match the successful retained recovery allocation, not its failed first attempt.
    withName: collect_subhogs {
        cpus = 16
        memory = 280.GB
    }
    withName: extract_pairwise_ortholog_relations {
        cpus = 16
        memory = 280.GB
    }
}

trace {
    enabled = true
    file = "${launchDir}/trace.txt"
}
