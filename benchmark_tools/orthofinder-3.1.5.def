Bootstrap: docker
From: python:3.12-slim-bookworm

%labels
    org.opencontainers.image.title OrthoFinder
    org.opencontainers.image.version 3.1.5
    org.opencontainers.image.source https://github.com/OrthoFinder/OrthoFinder/releases/tag/v3.1.5
    org.opencontainers.image.description "OrthoFinder 3.1.5 for OrthoHMM benchmarks"

%post
    set -eu
    apt-get update
    apt-get install -y --no-install-recommends build-essential ca-certificates curl

    archive=/tmp/orthofinder-linux-intel-3.1.5.tar.gz
    curl -fsSL -o "${archive}" \
        https://github.com/OrthoFinder/OrthoFinder/releases/download/v3.1.5/orthofinder-linux-intel-3.1.5.tar.gz
    echo "d74b5dbf9348e7ffdb735f1fda4ff9c49f504261811355519cf9dafcf80e7739  ${archive}" \
        | sha256sum -c -

    python -m pip install --no-cache-dir "${archive}"
    python -m pip freeze | sort > /opt/orthofinder-3.1.5-requirements.txt
    rm -f "${archive}"

    apt-get purge -y --auto-remove build-essential curl
    rm -rf /var/lib/apt/lists/* /root/.cache

%test
    test "$(orthofinder --version)" = "OrthoFinder:v3.1.5"

%runscript
    exec orthofinder "$@"
